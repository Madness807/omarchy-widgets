widget "Libre summary" {
  meta { owl: 12; description: "Summary of the Libre app: time free from each habit, the next milestone, and a notification at each one"; version: "1.1"; license: "MIT"; category: "productivity" }
  page: 2
  order: 2
  size: 6x3
  minSize: 3x3

  // The Libre app writes this summary on every change; the widget doesn't share its state.
  source data = file("~/.local/share/libre/resume.json") json
  source now = clock every 1m
  source drawer = android.drawer

  // One logo per type, line-drawn like the app's icon; Image { tint } colors them.
  asset ic_vape = base64""
  asset ic_tabac = base64""
  asset ic_alcool = base64""
  asset ic_soda = base64""
  asset ic_reseaux = base64""
  asset ic_autre = base64""
  asset ic_porno = base64""
  let logos = {vape: ic_vape, tabac: ic_tabac, alcool: ic_alcool, soda: ic_soda, reseaux: ic_reseaux, porno: ic_porno, autre: ic_autre}

  let display = "https://raw.githubusercontent.com/google/fonts/main/ofl/outfit/Outfit%5Bwght%5D.ttf"
  let teinte = {vape: cyan, tabac: orange, alcool: magenta, soda: yellow, reseaux: red, porno: blue, autre: green}
  let paliers = [
    {t: 86400, l: "1 day", c: "1 d"}, {t: 259200, l: "3 days", c: "3 d"}, {t: 604800, l: "1 week", c: "1 wk"},
    {t: 1209600, l: "2 weeks", c: "2 wk"}, {t: 2592000, l: "1 month", c: "1 mo"}, {t: 8640000, l: "100 days", c: "100 d"},
    {t: 15552000, l: "6 months", c: "6 mo"}, {t: 31536000, l: "1 year", c: "1 yr"}, {t: 43200000, l: "500 days", c: "500 d"},
    {t: 63072000, l: "2 years", c: "2 yr"}, {t: 86400000, l: "1000 days", c: "1000 d"}, {t: 157680000, l: "5 years", c: "5 yr"}
  ]
  let items = data.items ?? []
  let cur = data.currency ?? "$"
  let serre = cols == null || cols >= 5 ? len(items) >= 4 : true     // narrow cards: shorter texts
  let appli = (drawer.apps ?? []).find(a => a.kind == "owl" && a.name == "Libre")
  let debutJour = parseTime(fmtTime(now, "yyyy-MM-dd"))
  let enviesJour = count(data.envies ?? [], t => t >= debutJour)
  let economise = sum(items.map(a => max(0, now - a.debut) / 604800 * (a.parSemaine ?? 0)))

  // The next milestone across every quit, for the notification.
  let prochains = items.map(a => {nom: a.nom, p: paliers.find(p => a.debut + p.t > now), debut: a.debut}).filter(x => x.p != null)
  let prochain = prochains.sortBy(x => x.debut + x.p.t).first()
  let quand = prochain != null ? prochain.debut + prochain.p.t : 0

  at quand {
    notify("Libre · ${prochain.p.l} without ${lower(prochain.nom)}", "Another milestone reached. Well done, keep going!")
  }

  onTap: { if appli != null { open(appli.key) } }

  Column {
    gap: 8
    fill: true
    Row {
      Text { text: "LIBRE"; style: label; color: accent; letterSpacing: 2; weight: 1 }
      Text { text: economise > 0 ? "${cur}${fmtNum(economise)} saved" : "${enviesJour} craving${enviesJour == 1 ? "" : "s"} resisted today"; style: small; color: economise > 0 ? green : muted; maxLines: 1 }
    }
    if len(items) == 0 {
      Spacer { weight: 1 }
      Text { text: "Open the Libre app to get started."; color: muted; align: center }
      Spacer { weight: 1 }
    } else {
      Row {
        weight: 1
        gap: 8
        for a in items.take(cols != null && cols < 5 ? 2 : 4) key a.id {
          Column {
            let el = max(0, now - a.debut)
            let tint = teinte[a.type] ?? green
            let j = floor(el / 86400)
            let ans = floor(j / 365)
            let rj = j % 365
            let pal = paliers.find(p => p.t > el)
            let reste = pal != null ? pal.t - el : 0
            let avant = (paliers.filter(p => p.t <= el).last() ?? {t: 0}).t
            let part = pal != null ? (el - avant) / (pal.t - avant) * 100 : 100
            let dans = reste >= 86400 ? "${ceil(reste / 86400)} d" : reste >= 3600 ? "${floor(reste / 3600)} h" : "${max(1, ceil(reste / 60))} min"
            weight: 1
            fill: height
            Column {
            fill: true
            gap: 0
            padding: [10, 8]
            radius: 10 * corners
            background: linear(0, 0, 0, 1, [alpha(tint, 0.16), alpha(tint, 0.04)])
            border: 1
            borderColor: alpha(tint, 0.3)
            Text { text: upper(a.nom); style: label; color: tint; letterSpacing: serre ? 0 : 1; fontSize: serre ? 10 : 11; maxLines: 1 }
            if pal != null {
              Row {
                gap: 6
                Text { text: serre ? replace(pal.c, " ", "") : "→ ${pal.l}"; fontSize: serre ? 9 : 10; color: muted; maxLines: 1; weight: 1 }
                Text { text: serre ? replace(dans, " ", "") : "in ${dans}"; fontSize: serre ? 9 : 10; color: muted; maxLines: 1 }
              }
              Spacer { height: 6 }
              Progress { value: part; height: 4; fill: width; color: tint; track: alpha(tint, 0.15); animate value: spring() }
            }
            Spacer { weight: 1 }
            Image { src: logos[a.type] ?? ic_autre; size: 22; tint: alpha(tint, 0.9); label: a.nom }
            Text { text: ans >= 1 ? "${fmtNum(ans)} yr" : j >= 1 ? fmtNum(j) : "${floor(el / 3600)} h"; fontSize: 30; fontWeight: 700; font: display; maxLines: 1 }
            Text { text: ans >= 1 ? (rj > 0 ? "+ ${rj} d" : "exactly!") : j >= 1 ? (j > 1 ? "days" : "day") : "${floor(el % 3600 / 60)} min"; style: small; color: muted; maxLines: 1 }
            }
          }
        }
      }
    }
  }
}
