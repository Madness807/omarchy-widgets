widget "stargate" {
  size: 3x3
  minSize: 2x2

  meta { owl: 9; description: "The SGC's Milky Way stargate: dial real addresses on a round DHD, watch the ring turn, the chevrons lock and the kawoosh, close the iris on unscheduled off-world activations"; version: "4.1"; license: "MIT"; category: "fun" }
  requires { pacman: ["python", "libpulse"] }

  // t counts seconds of the current sequence, -1 when the gate is idle.
  // Outgoing ("out"): 3 s per chevron. Step k = floor(t / 3): in its first second chevron k locks
  // (the top chevron engages), then the ring turns to the next glyph. Step 7 is the kawoosh, step 8 open.
  // Incoming ("in"): the ring doesn't turn; one chevron a second, the kawoosh at t = 7, open from t = 8.
  state t = -1
  state dir = "out"
  state custom = []            // the six glyphs picked on the DHD; 1, the point of origin, comes last
  state rest = 0 persist       // the inner ring's angle while idle
  state sound = true persist
  state iris = false persist   // the SGC's iris, closed or open
  state incomingOn = true persist
  state nextCall = 0 persist   // when the next unscheduled off-world activation may come
  state idc = ""               // the IDC sent with an incoming wormhole ("" = none)
  state closesAt = 0           // when the open wormhole shuts down (38 minutes at most)
  state go = false
  state tapG = -1
  state tapR = 0

  source now = clock every 1s

  // Sound effects, synthesized once into ~/.cache/stargate/v2 and played with paplay.
  source sfx = cmd("""d=~/.cache/stargate/v2; [ -f "$d/iris.wav" ] || python3 -c 'if 1:
    import math, os, random, struct, wave
    R = 24000
    d = os.path.expanduser("~/.cache/stargate/v2")
    os.makedirs(d, exist_ok=True)
    random.seed(39)
    TAU = 2 * math.pi

    def n(sec): return int(R * sec)

    def lay(dst, src, at=0.0, g=1.0):
        o = n(at)
        need = o + len(src) - len(dst)
        if need > 0: dst.extend([0.0] * need)
        for i, v in enumerate(src): dst[o + i] += v * g
        return dst

    def noise(sec, cut):
        out, y = [], 0.0
        for i in range(n(sec)):
            c = cut(i / R) if callable(cut) else cut
            y += (1 - math.exp(-TAU * c / R)) * (random.uniform(-1, 1) - y)
            out.append(y)
        return out

    def tone(sec, f0, f1, amp):
        out, ph = [], 0.0
        for i in range(n(sec)):
            t = i / R
            ph += TAU * (f0 + (f1 - f0) * t / sec) / R
            out.append(math.sin(ph) * amp(t))
        return out

    def env(sig, f): return [v * f(i / R) for i, v in enumerate(sig)]

    def save(name, sig):
        with wave.open(f"{d}/{name}.wav", "wb") as w:
            w.setnchannels(1); w.setsampwidth(2); w.setframerate(R)
            w.writeframes(b"".join(struct.pack("<h", int(math.tanh(v * 0.9) * 30000)) for v in sig))

    # DHD key: a short two-tone chirp
    press = lay(tone(0.14, 660, 640, lambda t: 0.25 * math.exp(-30 * t)), tone(0.14, 990, 980, lambda t: 0.15 * math.exp(-40 * t)))

    # DHD dome: a deeper chirp that rises
    dome = lay(tone(0.3, 330, 520, lambda t: 0.3 * math.exp(-9 * t)), tone(0.3, 660, 1040, lambda t: 0.12 * math.exp(-12 * t)))

    # inner ring turning: a low grind with a ratchet
    def dial():
        L = 1.7
        grind = env(noise(L, 350), lambda t: 1.6)
        rumble = tone(L, 46, 50, lambda t: 0.22)
        s = lay(lay([0.0] * n(L), grind), rumble)
        k = 0.0
        while k < L - 0.05:
            click = env(noise(0.02, 2500), lambda t: 1.4 * math.exp(-250 * t))
            lay(s, click, k)
            k += 1 / 13
        fade = lambda t: min(1, t / 0.15) * min(1, (L - t) / 0.25)
        return env(s, lambda t: 0.75 * fade(t))

    # chevron engaging: two heavy clunks and a hiss
    def clunk():
        s = tone(0.5, 70, 45, lambda t: 0.8 * math.exp(-11 * t))
        lay(s, env(noise(0.3, 1400), lambda t: 1.8 * math.exp(-28 * t)))
        lay(s, tone(0.35, 90, 60, lambda t: 0.45 * math.exp(-14 * t)), 0.17)
        lay(s, env(noise(0.25, 1800), lambda t: 1.0 * math.exp(-30 * t)), 0.17)
        lay(s, env(noise(0.5, 4000), lambda t: 0.12 * math.exp(-6 * t)), 0.05)
        return s

    def kawoosh():
        s = clunk()
        L = 1.8
        cut = lambda t: 200 + 5000 * (t / 0.2) if t < 0.2 else 300 + 4900 * math.exp(-3 * (t - 0.2))
        burst = env(noise(L, cut), lambda t: 1.7 * min(1, t / 0.06) * math.exp(-1.6 * t))
        lay(s, burst, 0.4)
        lay(s, tone(1.2, 60, 32, lambda t: 0.6 * math.exp(-2.5 * t)), 0.4)
        hum = lay(tone(1.4, 72, 72, lambda t: 0.18), tone(1.4, 108, 108, lambda t: 0.08))
        lay(s, env(hum, lambda t: min(1, t / 0.4) * min(1, (1.4 - t) / 0.8)), 1.2)
        return s

    def fail():
        s = clunk()
        buzz = []
        ph = 0.0
        for i in range(n(0.9)):
            t = i / R
            ph += TAU * (180 - 100 * t) / R
            buzz.append((1 if math.sin(ph) > 0 else -1) * 0.12 * math.exp(-2.5 * t) * min(1, t / 0.02))
        lay(s, buzz, 0.3)
        return s

    def close():
        s = env(noise(1.1, lambda t: 3000 * math.exp(-3.5 * t) + 80), lambda t: 1.6 * min(1, t / 0.05) * math.exp(-2.2 * t))
        lay(s, tone(1.1, 260, 35, lambda t: 0.35 * math.exp(-2.5 * t)))
        return s

    # the gate room klaxon: three blasts of a buzzing horn
    def alarm():
        s = []
        for k in range(3):
            horn = []
            ph = 0.0
            for i in range(n(0.34)):
                t = i / R
                ph += TAU * (500 - 40 * t / 0.34) / R
                a = min(1, t / 0.02) * min(1, (0.34 - t) / 0.05)
                horn.append((math.sin(ph) + 0.45 * math.sin(2 * ph) + 0.25 * math.sin(3 * ph)) * 0.2 * a)
            lay(s, horn, k * 0.45)
        return s

    # the iris: blades sliding shut, a run of ticks, a heavy seat
    def irisfx():
        L = 0.75
        s = env(noise(L, 2600), lambda t: 0.5 * min(1, t / 0.05) * min(1, (L - t) / 0.2))
        k = 0.0
        while k < 0.6:
            lay(s, env(noise(0.015, 5000), lambda t: 1.0 * math.exp(-300 * t)), k)
            k += 0.03
        lay(s, tone(0.4, 160, 110, lambda t: 0.6 * math.exp(-12 * t)), 0.6)
        lay(s, env(noise(0.2, 1200), lambda t: 1.2 * math.exp(-25 * t)), 0.6)
        return s

    save("press", press)
    save("dome", dome)
    save("dial", dial())
    save("lock", clunk())
    save("kawoosh", kawoosh())
    save("fail", fail())
    save("close", close())
    save("alarm", alarm())
    save("iris", irisfx())
'; [ -f "$d/iris.wav" ] && echo ready""") every 24h timeout 30s

  // The address book: every complete Milky Way address from the show (rdanderson.com's glyph list).
  let book = [
    {name: "Abydos", glyphs: [27, 7, 15, 32, 12, 30, 1]},
    {name: "Apophis's base", glyphs: [20, 18, 11, 38, 10, 32, 1]},
    {name: "Castiana & Sahal I", glyphs: [29, 3, 6, 9, 12, 16, 1]},
    {name: "Castiana & Sahal II", glyphs: [29, 18, 19, 20, 21, 22, 1]},
    {name: "Chulak", glyphs: [9, 2, 23, 15, 37, 20, 1]},
    {name: "Clava Thessara Infinitas I", glyphs: [14, 21, 16, 11, 30, 7, 1]},
    {name: "Clava Thessara Infinitas II", glyphs: [26, 20, 35, 32, 23, 4, 1]},
    {name: "Destroyers", glyphs: [3, 32, 16, 8, 10, 12, 1]},
    {name: "Earth (SGC)", glyphs: [28, 26, 5, 36, 11, 29, 1]},
    {name: "Edora (P5C-768)", glyphs: [28, 38, 35, 9, 15, 3, 1]},
    {name: "Euronda", glyphs: [30, 27, 9, 7, 18, 16, 1]},
    {name: "Juna (P3X-729)", glyphs: [29, 8, 18, 22, 4, 25, 1]},
    {name: "Kallana", glyphs: [6, 16, 8, 3, 26, 25, 1]},
    {name: "Kheb", glyphs: [26, 35, 6, 8, 23, 14, 1]},
    {name: "K'tau", glyphs: [18, 2, 30, 12, 26, 33, 1]},
    {name: "Martin Lloyd's world", glyphs: [24, 12, 32, 7, 11, 34, 1]},
    {name: "NID off-world base", glyphs: [38, 28, 15, 35, 3, 19, 1]},
    {name: "P2X-555", glyphs: [28, 8, 16, 33, 13, 31, 1]},
    {name: "P34-353J", glyphs: [38, 9, 28, 15, 35, 3, 1]},
    {name: "P3W-451", glyphs: [19, 8, 4, 37, 26, 16, 1]},
    {name: "P3X-118", glyphs: [9, 26, 34, 37, 17, 21, 1]},
    {name: "P3X-562", glyphs: [3, 28, 9, 35, 24, 15, 1]},
    {name: "P9C-372", glyphs: [25, 8, 18, 29, 4, 22, 1]},
    {name: "PB5-926", glyphs: [12, 36, 23, 18, 7, 27, 1]},
    {name: "Camelot (PX1-767)", glyphs: [20, 2, 35, 8, 26, 15, 1]},
    {name: "Praclarush Taonas", glyphs: [35, 3, 31, 29, 5, 17, 1]},
    {name: "Sangreal planet", glyphs: [30, 19, 34, 9, 33, 18, 1]},
    {name: "Tartarus", glyphs: [33, 28, 23, 26, 16, 31, 1]},
    {name: "Tollan", glyphs: [6, 33, 27, 37, 11, 18, 1]},
    {name: "Tollana", glyphs: [4, 29, 8, 22, 18, 25, 1]},
    {name: "Vagon Brei", glyphs: [3, 8, 2, 12, 19, 30, 1]},
    {name: "SG-1's last address", glyphs: [9, 18, 27, 15, 21, 36, 1]}
  ]

  let full = custom + [1]
  let match = book.find(b => join(b.glyphs, ",") == join(full, ","))
  let dest = {name: match.name ?? "unknown address", glyphs: full}
  let home = match.name == "Earth (SGC)"   // a gate can't dial itself
  // an address nobody knows: chevron 7 won't lock
  let failing = dir == "out" && (match == null || home)
  let ready = t < 0 && len(custom) == 6
  let step = t < 0 ? -1 : floor(t / 3)
  let phase = t < 0 ? 0 : t % 3
  let holdT = dir == "in" ? 8 : 24          // the sequence waits here while the wormhole is open
  let idcs = ["SG-1", "SG-3", "SG-9", "Tok'ra", "", ""]

  every 1s { rest = failing && t >= 26 ? ringRot : rest; t = t < 0 ? t : failing && t >= 26 ? -1 : t >= holdT ? t : t + 1 }
  at closesAt { rest = dir == "out" ? ringRot : rest; t = -1; closesAt = 0 }

  // unscheduled off-world activations, every 30 minutes to 2 hours while the page is on screen
  every 20s {
    go = incomingOn && t < 0 && nextCall > 0 && now >= nextCall
    idc = go ? idcs[floor(now) % 6] : idc
    dir = go ? "in" : dir
    t = go ? 0 : t
    nextCall = now == null ? nextCall : go || nextCall == 0 || nextCall == null ? now + 1800 + floor(now * 7919) % 5400 : nextCall
  }

  on locked { haptic() }
  on iris { if sound { run("paplay ~/.cache/stargate/v2/iris.wav") } }
  on t {
    let fx = !sound ? "" : dir == "in" ? (
        value == 0 ? "alarm"
        : value >= 1 && value <= 6 ? "lock"
        : value == 7 ? "kawoosh"
        : value == -1 && old >= 7 ? "close"
        : "")
      : (
        value == 0 ? "dial"
        : value >= 3 && value < 21 && value % 3 == 0 ? "lock"
        : value >= 3 && value < 21 && value % 3 == 1 ? "dial"
        : value == 21 ? (failing ? "fail" : "kawoosh")
        : value == -1 && old >= 21 && !failing ? "close"
        : "")
    if fx == "alarm" { run("paplay ~/.cache/stargate/v2/alarm.wav") }
    else if fx == "lock" { run("paplay ~/.cache/stargate/v2/lock.wav") }
    else if fx == "dial" { run("paplay ~/.cache/stargate/v2/dial.wav") }
    else if fx == "kawoosh" { run("paplay ~/.cache/stargate/v2/kawoosh.wav") }
    else if fx == "fail" { run("paplay ~/.cache/stargate/v2/fail.wav") }
    else if fx == "close" { run("paplay ~/.cache/stargate/v2/close.wav") }
    // "close the iris!": the SGC shuts it before an incoming kawoosh
    iris = dir == "in" && value == 6 ? true : iris
    closesAt = value < 0 ? 0 : value == holdT && !failing ? now + (dir == "in" ? 25 + floor(now) % 35 : 38 * 60) : closesAt
  }

  onTap: screen()

  let addr = t < 0 ? custom : dir == "in" ? [] : full

  // The 39 glyphs of the Milky Way gate, traced from rdanderson.com's glyph chart (1 is Earth's point of origin).
  asset g01 = base64""
  asset g02 = base64""
  asset g03 = base64""
  asset g04 = base64""
  asset g05 = base64""
  asset g06 = base64""
  asset g07 = base64""
  asset g08 = base64""
  asset g09 = base64""
  asset g10 = base64""
  asset g11 = base64""
  asset g12 = base64""
  asset g13 = base64""
  asset g14 = base64""
  asset g15 = base64""
  asset g16 = base64""
  asset g17 = base64""
  asset g18 = base64""
  asset g19 = base64""
  asset g20 = base64""
  asset g21 = base64""
  asset g22 = base64""
  asset g23 = base64""
  asset g24 = base64""
  asset g25 = base64""
  asset g26 = base64""
  asset g27 = base64""
  asset g28 = base64""
  asset g29 = base64""
  asset g30 = base64""
  asset g31 = base64""
  asset g32 = base64""
  asset g33 = base64""
  asset g34 = base64""
  asset g35 = base64""
  asset g36 = base64""
  asset g37 = base64""
  asset g38 = base64""
  asset g39 = base64""
  let glyphImg = [g01, g02, g03, g04, g05, g06, g07, g08, g09, g10, g11, g12, g13, g14, g15, g16, g17, g18, g19, g20, g21, g22, g23, g24, g25, g26, g27, g28, g29, g30, g31, g32, g33, g34, g35, g36, g37, g38, g39]

  // The ring turns each glyph to the top chevron, alternating direction, always at least 60°.
  let a = 360 / 39
  let tg = full.map(g => -(g - 1) * a)
  let d0 = (tg[0] - rest) - floor((tg[0] - rest) / 360) * 360
  let r0 = rest + d0 + (d0 < 60 ? 360 : 0)
  let d1 = 360 - ((tg[1] - r0) - floor((tg[1] - r0) / 360) * 360)
  let r1 = r0 - d1 - (d1 < 60 ? 360 : 0)
  let d2 = (tg[2] - r1) - floor((tg[2] - r1) / 360) * 360
  let r2 = r1 + d2 + (d2 < 60 ? 360 : 0)
  let d3 = 360 - ((tg[3] - r2) - floor((tg[3] - r2) / 360) * 360)
  let r3 = r2 - d3 - (d3 < 60 ? 360 : 0)
  let d4 = (tg[4] - r3) - floor((tg[4] - r3) / 360) * 360
  let r4 = r3 + d4 + (d4 < 60 ? 360 : 0)
  let d5 = 360 - ((tg[5] - r4) - floor((tg[5] - r4) / 360) * 360)
  let r5 = r4 - d5 - (d5 < 60 ? 360 : 0)
  let d6 = (tg[6] - r5) - floor((tg[6] - r5) / 360) * 360
  let r6 = r5 + d6 + (d6 < 60 ? 360 : 0)
  let rs = [r0, r1, r2, r3, r4, r5, r6]
  // while chevron k locks the ring holds still, then turns on to the next glyph
  let ringRot = t < 0 || dir == "in" ? rest : rs[step >= 7 ? 6 : phase == 0 && step >= 1 ? step - 1 : step]

  let locked = t < 0 ? 0 : dir == "in" ? min(t, 7) : failing ? min(step, 6) : min(step, 7)
  let pop = dir == "out" && phase == 0 && step >= 1 && step <= 7   // the top chevron engages
  let open = t >= 0 && (dir == "in" ? t >= 7 : step >= 7 && !failing)
  let settled = dir == "in" ? t >= 8 : t >= 22
  let kaw = t >= 0 && (dir == "in" ? t == 7 : t == 21 && !failing)
  // chevrons 1-3 on the right, 4-6 on the left, 7 at the top; 8 and 9 stay dark
  let chevAngles = [40, 80, 120, 240, 280, 320, 0, 160, 200]

  let stone = mix(surface, foreground, 0.18)
  let glow = orange

  let left = max(0, closesAt - (now ?? 0))
  let mmss = "${floor(left / 60)}:${pad(floor(left % 60), 2, "0")}"
  let status = t < 0 ? (len(custom) < 6 ? "pick ${6 - len(custom)} glyph${len(custom) == 5 ? "" : "s"}" : "ready: ${dest.name}")
    : dir == "in" ? (t < 7 ? "unscheduled off-world activation!" : t == 7 ? "incoming wormhole"
      : idc == "" ? (iris ? "incoming · no IDC" : "iris open, no IDC!")
      : iris ? "receiving IDC: ${idc}" : "${idc} coming through")
    : step < 7 ? (locked == 0 ? "dialing…" : "chevron ${locked} encoded")
    : failing ? (home ? "a gate can't dial itself" : "chevron 7 will not lock")
    : step == 7 && phase == 0 ? "chevron 7 locked" : "${dest.name} · ${mmss}"
  let alarmOn = dir == "in" && t >= 0 && (t < 8 || (idc == "" && !iris))
  let statusColor = alarmOn ? red : failing && step >= 7 ? red : open ? cyan : t >= 0 ? glow : muted

  // one glyph, drawn from its strokes and stars
  component GlyphMark(g, tint) {
    Canvas { image(glyphImg[g - 1], 0, 0, width, height, color: tint) }
  }

  // the chevrons: the top one (upper) is drawn on its own so it can engage
  component Chevrons(upper, sc) {
    Canvas {
      fill: true
      scale: sc
      animate scale: spring(0.6, 500)
      let cx = width / 2
      let cy = height / 2
      let R = min(width, height) / 2 - 4
      let w = R * 0.11
      if !upper { circle(cx, cy, R * 0.665, stroke: mix(stone, background, 0.4), width: R * 0.03) }
      for ang, i in chevAngles {
        if (i == 6) == upper {
          let lit = i < locked
          rotate(ang, cx, cy) {
            if lit { circle(cx, cy - R * 0.93, R * 0.12, fill: alpha(glow, 0.35)) }
            path([[cx - w, cy - R * 1.0], [cx + w, cy - R * 1.0], [cx + w * 0.3, cy - R * 0.83], [cx - w * 0.3, cy - R * 0.83]], closed: true, fill: lit ? glow : mix(stone, background, 0.35))
            path([[cx - w * 0.45, cy - R * 0.97], [cx + w * 0.45, cy - R * 0.97], [cx, cy - R * 0.88]], closed: true, fill: lit ? bright_yellow : alpha(background, 0.5))
          }
        }
      }
    }
  }

  component Gate() {
    Box {
      align: center

      // outer stone ring
      Canvas {
        fill: true
        let cx = width / 2
        let cy = height / 2
        let R = min(width, height) / 2 - 4
        circle(cx, cy, R * 0.67, fill: alpha(background, 0.85))
        circle(cx, cy, R * 0.91, stroke: stone, width: R * 0.18)
        circle(cx, cy, R * 0.995, stroke: alpha(foreground, 0.25), width: 1)
        circle(cx, cy, R * 0.82, stroke: alpha(background, 0.6), width: 1.5)
      }

      // inner glyph ring, turned by the dial
      Canvas {
        fill: true
        rotation: ringRot
        animate rotation: tween(1800ms, "ease")
        let cx = width / 2
        let cy = height / 2
        let R = min(width, height) / 2 - 4
        let s = R * 0.072
        let y = cy - R * 0.745
        circle(cx, cy, R * 0.745, stroke: mix(stone, background, 0.25), width: R * 0.15)
        for i in range(39) {
          let at = addr.indexOf(i + 1)
          let c = at >= 0 && at < locked ? glow : at >= 0 ? alpha(foreground, 0.9) : alpha(foreground, 0.5)
          rotate(i * a, cx, cy) { image(glyphImg[i], cx - s, y - s, s * 2, s * 2, color: c) }
          rotate((i + 0.5) * a, cx, cy) { line(cx, cy - R * 0.82, cx, cy - R * 0.80, stroke: alpha(background, 0.7), width: 1) }
        }
      }

      // event horizon
      if open {
        Shader {
          fill: true
          fallback: transparent
          scale: settled ? 1 : 0.15
          animate scale: spring(0.35, 180)
          uniforms: { c1: blue, c2: cyan, frac: 0.66 }
          code: """
            uniform half4 c1;
            uniform half4 c2;
            uniform float frac;
            half4 main(float2 p) {
              float2 d = p - size * 0.5;
              float R = min(size.x, size.y) * 0.5 * frac;
              float r = length(d) / R;
              if (r > 1.0) { return half4(0.0); }
              float ang = atan(d.y, d.x);
              float w = sin(r * 16.0 - time * 3.0 + sin(ang * 3.0 + time * 0.8) * 1.4) * 0.5 + 0.5;
              float core = smoothstep(1.0, 0.0, r);
              half3 col = mix(c1.rgb * 0.7, c2.rgb, w * 0.55 + core * 0.35);
              col += half3(0.35) * pow(w, 8.0) * core;
              float edge = smoothstep(1.0, 0.93, r);
              return half4(col * edge, edge);
            }
          """
        }
      }

      // the kawoosh: the unstable vortex bursts out of the gate, then falls back into the puddle
      Canvas {
        fill: true
        opacity: kaw && !iris ? 1 : 0
        scale: kaw && !iris ? 1.3 : 0.3
        animate scale: spring(0.45, 260)
        animate opacity: tween(600ms, "out")
        let cx = width / 2
        let cy = height / 2
        let R = (min(width, height) / 2 - 4) * 0.66
        circle(cx, cy, R, fill: radial(cx, cy, R, [mix(foreground, bright_cyan, 0.3), bright_cyan, alpha(blue, 0.6), alpha(blue, 0)]))
      }

      // the SGC's iris: twenty blades spiralling shut
      Canvas {
        fill: true
        opacity: iris ? 1 : 0
        rotation: iris ? 0 : -70
        animate opacity: tween(900ms, "ease")
        animate rotation: tween(900ms, "ease")
        let cx = width / 2
        let cy = height / 2
        let R = min(width, height) / 2 - 4
        let ri = R * 0.665
        circle(cx, cy, ri, fill: mix(surface, foreground, 0.32))
        for i in range(20) {
          if i % 2 == 0 { arc(cx, cy, ri, i * 18, 18, fill: alpha(foreground, 0.06)) }
          rotate(i * 18, cx, cy) {
            path([[cx, cy], [cx + ri * 0.22, cy - ri * 0.42], [cx + ri * 0.2, cy - ri * 0.98]], stroke: alpha(background, 0.6), width: max(1, R * 0.012))
          }
        }
        circle(cx, cy, R * 0.03, fill: alpha(background, 0.6))
      }

      Chevrons { upper: false; sc: 1 }
      Chevrons { upper: true; sc: pop ? 0.955 : 1 }
    }
  }

  Column {
    gap: 2
    align: center
    Gate { weight: 1; fill: width }
    Text {
      text: t < 0 ? "tap to dial" : alarmOn && t < 7 ? "off-world activation!" : status
      style: small; align: center; maxLines: 1; color: statusColor
    }
    if rows >= 3 && t >= 0 && dir == "out" {
      Text {
        text: join(full.take(locked).map(g => pad(g, 2, "0")), "·")
        font: mono; fontSize: 10; align: center; color: muted; maxLines: 1
      }
    }
  }

  let gateSize = min((screenWidth ?? 360) - 32, 340)
  let dhd = min((screenWidth ?? 360) - 32, 360)

  screen {
    title: "stargate"
    Column {
      scroll: true
      gap: 12
      padding: [16, 8]
      align: center

      Gate { height: gateSize; fill: width }
      Text { text: status; style: title; align: center; color: statusColor; maxLines: 1 }

      // the address: six picked glyphs and the point of origin
      Row {
        gap: 6
        fill: width
        for i in range(7) {
          let g = i == 6 ? 1 : custom[i]
          let lit = dir == "out" && i < locked
          Column {
            weight: 1
            height: 52
            gap: 2
            align: center
            justify: center
            border: 1
            borderColor: lit ? glow : g == null ? alpha(border, 0.5) : border
            background: lit ? alpha(glow, 0.15) : transparent
            if g != null {
              GlyphMark { g: g; tint: lit ? glow : foreground; width: 22; height: 22 }
              Text { text: pad(g, 2, "0"); font: mono; fontSize: 10; color: muted; align: center }
            }
          }
        }
      }

      Row {
        gap: 8
        fill: width
        Button { text: "⌫"; width: 56; onTap: { if sound && t < 0 && len(custom) > 0 { run("paplay ~/.cache/stargate/v2/press.wav") }; custom = t < 0 ? custom.take(len(custom) - 1) : custom } }
        Button { text: "clear"; weight: 1; onTap: custom = t < 0 ? [] : custom }
        Button {
          text: t < 0 ? "dial" : dir == "in" ? "incoming" : "close gate"
          weight: 2
          color: t >= 0 && dir == "in" ? muted : t >= 0 ? red : ready ? glow : muted
          onTap: {
            rest = t >= 0 && dir == "out" ? ringRot : rest
            dir = ready ? "out" : dir
            t = ready ? 0 : t >= 0 && dir == "out" ? -1 : t
          }
        }
      }

      // the dial-home device: 2-20 on the outer ring, 21-39 on the inner, the red dome dials
      Text { text: "dial-home device"; style: label; fill: width }
      Canvas {
        width: dhd
        height: dhd
        onTap: {
          tapR = sqrt(pow(x - dhd / 2, 2) + pow(y - dhd / 2, 2)) / (dhd / 2 - 2)
          tapG = floor(((deg(atan2(x - dhd / 2, dhd / 2 - y)) + 360 + 180 / 19) % 360) / (360 / 19)) % 19
          tapG = tapR < 0.37 ? 0 : tapR < 0.39 || tapR > 1 ? -1 : tapR < 0.685 ? 21 + tapG : 2 + tapG
          if sound && t < 0 && tapG >= 2 && custom.indexOf(tapG) < 0 && len(custom) < 6 { run("paplay ~/.cache/stargate/v2/press.wav") }
          if sound && tapG == 0 && (ready || (t >= 0 && dir == "out")) { run("paplay ~/.cache/stargate/v2/dome.wav") }
          custom = t < 0 && tapG >= 2 && custom.indexOf(tapG) < 0 && len(custom) < 6 ? custom + [tapG] : custom
          rest = tapG == 0 && t >= 0 && dir == "out" ? ringRot : rest
          dir = tapG == 0 && ready ? "out" : dir
          t = tapG != 0 ? t : ready ? 0 : t >= 0 && dir == "out" ? -1 : t
        }
        let c = width / 2
        let Rd = c - 2
        let seg = 360 / 19
        let tn = tan(rad(seg / 2 - 1.2))
        let lit = ready || (t >= 0 && dir == "out")
        circle(c, c, Rd, fill: mix(stone, background, 0.45))
        circle(c, c, Rd, stroke: alpha(foreground, 0.25), width: 1)
        for k in range(19) {
          for ring in range(2) {
            let g = ring == 0 ? 2 + k : 21 + k
            let r1 = ring == 0 ? Rd * 0.70 : Rd * 0.40
            let r2 = ring == 0 ? Rd * 0.975 : Rd * 0.67
            let rm = (r1 + r2) / 2
            let s = min((r2 - r1) * 0.4, rm * tn * 0.92)
            let picked = custom.indexOf(g) >= 0
            let tint = picked ? bright_yellow : alpha(foreground, 0.85)
            rotate(k * seg, c, c) {
              path([[c - r2 * tn, c - r2], [c + r2 * tn, c - r2], [c + r1 * tn, c - r1], [c - r1 * tn, c - r1]], closed: true, fill: picked ? alpha(glow, 0.55) : mix(surface, foreground, 0.08))
              image(glyphImg[g - 1], c - s, c - rm - s, s * 2, s * 2, color: tint)
            }
          }
        }
        if lit { circle(c, c, Rd * 0.37, fill: alpha(red, 0.35)) }
        circle(c, c, Rd * 0.34, fill: radial(c - Rd * 0.08, c - Rd * 0.1, Rd * 0.42, [lit ? mix(bright_red, foreground, 0.35) : mix(red, foreground, 0.15), lit ? bright_red : red, mix(red, background, 0.55)]))
        circle(c - Rd * 0.1, c - Rd * 0.12, Rd * 0.07, fill: alpha(foreground, lit ? 0.35 : 0.18))
      }

      Grid {
        columns: 2
        gap: 8
        fill: width
        Button { text: iris ? "open iris" : "close iris"; color: iris ? accent : muted; onTap: iris = !iris }
        Button { text: sound ? "sound on" : "sound off"; color: sound ? accent : muted; onTap: sound = !sound }
        Button { text: incomingOn ? "activations on" : "activations off"; color: incomingOn ? accent : muted; onTap: incomingOn = !incomingOn }
        Button {
          text: "incoming!"
          color: t < 0 ? red : muted
          onTap: { go = t < 0; idc = go ? idcs[floor(now ?? 0) % 6] : idc; dir = go ? "in" : dir; t = go ? 0 : t }
        }
      }

      Text { text: "address book"; style: label; fill: width }
      for b in book key b.name {
        Row {
          fill: width
          padding: [10, 8]
          border: 1
          borderColor: alpha(border, 0.4)
          onTap: { if sound && t < 0 { run("paplay ~/.cache/stargate/v2/press.wav") }; custom = t < 0 ? b.glyphs.take(6) : custom }
          Text { text: b.name; weight: 1; bold: match.name == b.name }
          Text { text: join(b.glyphs.map(g => pad(g, 2, "0")), "·"); font: mono; fontSize: 12; color: muted; width: 170; align: end }
        }
      }
      Text { text: "An address that isn't in the book won't lock chevron 7. A wormhole stays open 38 minutes at most, and an incoming one can't be shut down from this side: close the iris unless the IDC checks out."; style: muted; fill: width }
    }
  }
}
