app "Libre" {
  meta { owl: 12; description: "Track what you're quitting (vape, smoking, alcohol…): time free, health milestones, badges, money saved, cravings resisted and guided breathing"; version: "1.1"; license: "MIT"; category: "productivity" }
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M24 43V23"/>
    <path d="M24 27C24 18 18 12 8 12c0 10 6 15 16 15z"/>
    <path d="M24 23c0-9 6-15 16-15 0 10-6 15-16 15z"/>
    <path d="M15 43h18"/>
  </svg>"""
  edge: true

  source now = clock every 1m
  source sec = clock every 1s

  // ------------------------------------------------------------ saved data
  // The data keys stay as they are (nom, debut, parSemaine…) so saved data keeps working.
  state items = [] persist             // {id, nom, type, debut, parSemaine, minJour, record, rechutes}
  state envies = [] persist            // cravings: {t, id, f: intensity 1 to 5, d: trigger}
  state motivation = "" persist
  state currency = "$" persist

  // ------------------------------------------------------------ navigation
  state vue = "accueil"                // accueil (home), journal, aide (help), fiche (detail), envie (craving), ajout (add)
  state retour = "accueil"
  state sel = ""
  state confirmer = ""
  state prix = ""
  state nomFiche = ""
  // a craving
  state eId = ""
  state eForce = 3
  state eDecl = ""
  state respDebut = 0
  state merci = 0                      // when the last craving was logged
  state toast = false
  // a new quit
  state nNom = ""
  state nType = "vape"
  state nDate = ""

  // One logo per type, line-drawn like the app's icon; Image { tint } colors them.
  asset ic_vape = base64""
  asset ic_tabac = base64""
  asset ic_alcool = base64""
  asset ic_soda = base64""
  asset ic_reseaux = base64""
  asset ic_autre = base64""
  asset ic_porno = base64""
  let logos = {vape: ic_vape, tabac: ic_tabac, alcool: ic_alcool, soda: ic_soda, reseaux: ic_reseaux, porno: ic_porno, autre: ic_autre}

  let display = "https://raw.githubusercontent.com/google/fonts/main/ofl/outfit/Outfit%5Bwght%5D.ttf"
  let teinte = {vape: cyan, tabac: orange, alcool: magenta, soda: yellow, reseaux: red, porno: blue, autre: green}
  let types = [{k: "vape", l: "Vape"}, {k: "tabac", l: "Smoking"}, {k: "alcool", l: "Alcohol"}, {k: "soda", l: "Soda"}, {k: "reseaux", l: "Social media"}, {k: "porno", l: "Porn"}, {k: "autre", l: "Other"}]
  let cur = trim(currency) != "" ? trim(currency) : "$"

  // Health milestones. Vaping: what comes from nicotine and habit; no combustion, so no carbon
  // monoxide or tar, and its effects on the lungs are less studied.
  let etapesPar = {
    vape: [
      {t: 1200, l: "20 minutes", d: "Your pulse and blood pressure start to come down."},
      {t: 28800, l: "8 hours", d: "The nicotine in your blood has dropped sharply."},
      {t: 86400, l: "1 day", d: "Your heart is no longer stimulated by nicotine."},
      {t: 259200, l: "3 days", d: "Nicotine has left your body. Withdrawal peaks, then fades: the hardest part is passing."},
      {t: 604800, l: "1 week", d: "Cravings come less often, mood and sleep settle down."},
      {t: 1209600, l: "2 weeks", d: "Your throat and airways are less irritated."},
      {t: 2592000, l: "1 month", d: "Your brain has readjusted to life without nicotine: more energy, less irritability."},
      {t: 7776000, l: "3 months", d: "Cravings become rare, your hand no longer reaches out on its own."},
      {t: 15552000, l: "6 months", d: "The urge to vape fades, even at risky moments."},
      {t: 31536000, l: "1 year", d: "A whole year free of nicotine."}
    ],
    tabac: [
      {t: 1200, l: "20 minutes", d: "Your pulse and blood pressure come down."},
      {t: 28800, l: "8 hours", d: "Carbon monoxide in your blood has halved, oxygen is rising."},
      {t: 86400, l: "1 day", d: "Carbon monoxide has been cleared."},
      {t: 172800, l: "2 days", d: "Taste and smell improve."},
      {t: 259200, l: "3 days", d: "Breathing gets easier, nicotine has left your body."},
      {t: 1209600, l: "2 weeks", d: "Circulation improves, exercise gets easier."},
      {t: 7776000, l: "3 months", d: "Your breathing improves clearly, coughing decreases."},
      {t: 23328000, l: "9 months", d: "The cilia in your lungs grow back: fewer infections, less breathlessness."},
      {t: 31536000, l: "1 year", d: "Your risk of heart attack has halved."},
      {t: 157680000, l: "5 years", d: "Your risk of stroke approaches that of a non-smoker."},
      {t: 315360000, l: "10 years", d: "Your risk of lung cancer has halved."},
      {t: 473040000, l: "15 years", d: "Your cardiovascular risk matches that of a non-smoker."}
    ],
    alcool: [
      {t: 86400, l: "1 day", d: "Your body has cleared the alcohol, blood sugar stabilizes."},
      {t: 259200, l: "3 days", d: "Physical withdrawal eases."},
      {t: 604800, l: "1 week", d: "Sleep becomes more restful, skin better hydrated."},
      {t: 1209600, l: "2 weeks", d: "Your stomach is less irritated: less reflux."},
      {t: 2592000, l: "1 month", d: "Liver fat decreases, blood pressure drops."},
      {t: 7776000, l: "3 months", d: "More energy, better focus and memory."},
      {t: 15552000, l: "6 months", d: "Your liver has largely recovered, unless it had cirrhosis."},
      {t: 31536000, l: "1 year", d: "Your risk of liver disease, heart disease and several cancers has gone down."}
    ],
    soda: [
      {t: 86400, l: "1 day", d: "No more sugar spikes: blood sugar stays steadier."},
      {t: 259200, l: "3 days", d: "If your soda had caffeine, withdrawal headaches and tiredness peak, then go away."},
      {t: 604800, l: "1 week", d: "Fewer slumps after meals, steadier energy."},
      {t: 1209600, l: "2 weeks", d: "Your taste adapts: you crave sweets less, fruit tastes sweeter."},
      {t: 2592000, l: "1 month", d: "Less sugar and acid on your teeth: less damage to the enamel."},
      {t: 7776000, l: "3 months", d: "The new habit is in place: water, sparkling water or tea instead."},
      {t: 31536000, l: "1 year", d: "Several kilos of sugar avoided, and a lower risk of type 2 diabetes."}
    ],
    reseaux: [
      {t: 86400, l: "1 day", d: "Your thumb still looks for the app: the reflex weakens each time it finds nothing."},
      {t: 259200, l: "3 days", d: "You pick up your phone for no reason less often."},
      {t: 604800, l: "1 week", d: "The urge to check comes less often, boredom becomes bearable again."},
      {t: 1209600, l: "2 weeks", d: "You can focus on one task for longer."},
      {t: 2592000, l: "1 month", d: "Less comparing yourself to others, better sleep without screens at night."},
      {t: 7776000, l: "3 months", d: "The time you got back has become something else: reading, sport, going out…"},
      {t: 15552000, l: "6 months", d: "You no longer wonder what you're missing."},
      {t: 31536000, l: "1 year", d: "A year taken back from the feed."}
    ],
    porno: [
      {t: 86400, l: "1 day", d: "The first day is done. The urge often comes from boredom, tiredness or stress."},
      {t: 259200, l: "3 days", d: "Urges can be strong: it's the habit asking, and it weakens if you don't feed it."},
      {t: 604800, l: "1 week", d: "Less time lost in the evening, often better sleep."},
      {t: 1209600, l: "2 weeks", d: "The reflex to open a tab comes less often."},
      {t: 2592000, l: "1 month", d: "More energy and focus, less guilt."},
      {t: 7776000, l: "3 months", d: "You know your triggers, urges are rare."},
      {t: 15552000, l: "6 months", d: "The new rhythm is set, even on hard evenings."},
      {t: 31536000, l: "1 year", d: "A whole year."}
    ],
    autre: [
      {t: 86400, l: "1 day", d: "The first day is done."},
      {t: 259200, l: "3 days", d: "Often the hardest stretch: it's behind you."},
      {t: 604800, l: "1 week", d: "One week: a new habit is starting."},
      {t: 2592000, l: "1 month", d: "Your brain adjusts, cravings come less often."},
      {t: 7776000, l: "3 months", d: "The new rhythm is well established."},
      {t: 31536000, l: "1 year", d: "A whole year."}
    ]
  }

  let paliers = [
    {t: 86400, c: "1", u: "day"}, {t: 259200, c: "3", u: "days"}, {t: 604800, c: "1", u: "week"},
    {t: 1209600, c: "2", u: "weeks"}, {t: 2592000, c: "1", u: "month"}, {t: 8640000, c: "100", u: "days"},
    {t: 15552000, c: "6", u: "months"}, {t: 31536000, c: "1", u: "year"}, {t: 43200000, c: "500", u: "days"},
    {t: 63072000, c: "2", u: "years"}, {t: 86400000, c: "1000", u: "days"}, {t: 157680000, c: "5", u: "years"}
  ]

  let declencheurs = ["Stress", "Coffee", "After eating", "Party", "Alcohol", "Boredom", "Tiredness", "Anger", "Friends", "Alone", "In bed", "Waking up", "Screens", "Other"]
  let forces = ["Slight", "Mild", "Medium", "Strong", "Very strong"]
  let conseils = [
    "A craving lasts 3 to 5 minutes. It passes, whether you give in or not.",
    "Drink a big glass of water, slowly.",
    "Change rooms, go for a two-minute walk.",
    "Keep your hands busy: a ball, a pen, your phone.",
    "Text someone who supports you.",
    "Remember why you quit.",
    "Chew something: gum, a carrot, an apple."
  ]

  // ------------------------------------------------------------ derived values
  // Each quit with what follows from it: el (seconds free), tint, ets (its milestones), at (reached),
  // suiv (the next one), part (progress toward it, 0 to 1), best (the record, current streak included).
  // Read only: handlers write to `items`.
  let suivis1 = items.map(a => merge(a, {el: max(0, now - a.debut), tint: teinte[a.type] ?? green, ets: etapesPar[a.type] ?? etapesPar.autre}))
  let suivis2 = suivis1.map(a => merge(a, {at: a.ets.filter(e => e.t <= a.el), suiv: a.ets.find(e => e.t > a.el), best: max(a.record ?? 0, a.el)}))
  let suivis = suivis2.map(a => merge(a, {part: a.suiv == null ? 1 : (a.el - (last(a.at).t ?? 0)) / (a.suiv.t - (last(a.at).t ?? 0))}))

  let item = suivis.find(a => a.id == sel)
  let iSec = item != null ? max(0, (sec ?? now) - item.debut) : 0
  let iJours = item != null ? floor(item.el / 86400) : 0
  let iEnvies = count(envies, e => e.id == sel)
  let iPalier = item != null ? paliers.find(p => p.t > item.el) : null
  let iTemps = item != null && (item.type == "reseaux" || item.type == "porno")     // counts time won back, not money
  let iHeures = iTemps ? item.el / 86400 * (item.minJour ?? 0) / 60 : 0

  let economise = sum(suivis.map(a => a.el / 604800 * (a.parSemaine ?? 0)))
  let meilleur = reduce(suivis, (m, a) => max(m, a.best), 0)
  let debutJour = parseTime(fmtTime(now, "yyyy-MM-dd"))
  let enviesJour = count(envies, e => e.t >= debutJour)
  let envies7 = count(envies, e => e.t >= debutJour - 6 * 86400)
  let jours14 = range(14).map(i => count(envies, e => e.t >= debutJour - (13 - i) * 86400 && e.t < debutJour - (12 - i) * 86400))
  let max14 = reduce(jours14, (m, x) => max(m, x), 1)
  let heures = range(24).map(h => count(envies, e => int(fmtTime(e.t, "H")) == h))
  let maxH = reduce(heures, (m, x) => max(m, x), 1)
  let heurePic = heures.indexOf(maxH)
  let declStats = declencheurs.map(d => {d: d, n: count(envies, e => e.d == d)}).filter(x => x.n > 0).sortBy(x => -x.n)
  let forceMoy = len(envies) > 0 ? avg(envies.map(e => e.f)) : 0
  let derniers = reverse(envies).take(30)

  // breathing: 4 s in, 6 s out
  let rt = respDebut > 0 && sec != null ? max(0, sec - respDebut) : 0
  let rPhase = rt % 10
  let rP1 = (rt + 1) % 10
  let rK = rP1 < 4 ? 0.5 - cos(rP1 / 4 * pi) / 2 : 0.5 + cos((rP1 - 4) / 6 * pi) / 2
  let rGrow = vue == "envie" ? lerp(0.45, 1, rK) : 0.45
  let eTint = teinte[get(items.find(a => a.id == eId) ?? {}, "type", "autre")] ?? accent

  let nDebut = trim(nDate) == "" ? now : parseTime(trim(nDate))
  let nOk = trim(nNom) != "" && nDebut != null && nDebut <= now + 60

  // Summary for the home-screen widget, which doesn't share the app's state.
  let resume = toJson({items: items.map(a => {id: a.id, nom: a.nom, type: a.type, debut: a.debut, parSemaine: a.parSemaine ?? 0}), envies: envies.drop(max(0, len(envies) - 60)).map(e => e.t), currency: cur})
  on resume first { run("mkdir -p ~/.local/share/libre && printf '%s' ${sh(resume)} > ~/.local/share/libre/resume.json") }

  at merci > 0 ? merci + 5 : 0 { toast = false }

  title: vue == "fiche" ? item.nom ?? "Libre" : vue == "envie" ? "A craving passes" : vue == "ajout" ? "New quit" : vue == "journal" ? "Journal" : vue == "aide" ? "Help" : "Libre"
  back: vue == "fiche" || vue == "envie" || vue == "ajout"
  onBack: { vue = retour; confirmer = ""; respDebut = 0 }

  // ------------------------------------------------------------ components
  component Chip(label, on = false, tint = accent) {
    Text { text: label; style: small; align: center; maxLines: 1; color: on ? background : foreground; bold: on
      width: len(label) * 7.5 + 26; padding: [0, 7]; radius: 14 * corners
      background: on ? tint : alpha(tint, 0.10); border: 1; borderColor: alpha(tint, on ? 1 : 0.35) }
  }

  component Section(label) {
    Text { text: label; style: label; color: muted; letterSpacing: 1.5; padding: [0, 6, 0, 0] }
  }

  component Stat(label, value, tint = foreground) {
    Column {
      weight: 1
      gap: 2
      padding: [12, 10]
      background: surface
      radius: 10 * corners
      Text { text: value; fontSize: 20; fontWeight: 600; font: display; color: tint; maxLines: 1 }
      Text { text: label; style: small; color: muted; maxLines: 1 }
    }
  }

  component Duree(s, style = "small", tint = muted) {
    Text {
      text: s >= 86400 ? "${floor(s / 86400)} d ${floor(s % 86400 / 3600)} h" : s >= 3600 ? "${floor(s / 3600)} h ${floor(s % 3600 / 60)} min" : "${max(1, ceil(s / 60))} min"
      style: style; color: tint; maxLines: 1
    }
  }

  component BoutonAjout(depuis) {
    Box {
      fill: width
      align: center
      padding: [0, 12]
      radius: 12 * corners
      border: 1
      borderColor: alpha(accent, 0.45)
      onTap: { vue = "ajout"; retour = depuis; nNom = ""; nType = "autre"; nDate = "" }
      Text { text: "+  Add a quit"; color: accent; bold: true; align: center }
    }
  }

  // The tab bar's icons, line-drawn like the app's.
  component Icone(k, tint) {
    Canvas {
      size: 24
      if k == "accueil" {
        path([[3, 11], [12, 3.5], [21, 11]], stroke: tint, width: 2, cap: round)
        path([[5.5, 9.5], [5.5, 20.5], [18.5, 20.5], [18.5, 9.5]], stroke: tint, width: 2, cap: round)
        line(12, 20.5, 12, 15, stroke: tint, width: 2, cap: round)
      } else if k == "journal" {
        line(5, 20, 5, 14, stroke: tint, width: 2.5, cap: round)
        line(12, 20, 12, 5, stroke: tint, width: 2.5, cap: round)
        line(19, 20, 19, 10, stroke: tint, width: 2.5, cap: round)
      } else {
        circle(12, 12, 8.5, stroke: tint, width: 2)
        circle(12, 12, 3.5, stroke: tint, width: 2)
        for g in [45, 135, 225, 315] { rotate(g, 12, 12) { line(12, 3.5, 12, 8.5, stroke: tint, width: 2) } }
      }
    }
  }

  // ------------------------------------------------------------ views
  Column {
    fill: true
    gap: 0

    if vue == "accueil" {
      Column {
        weight: 1
        scroll: true
        padding: [16, 8]
        gap: 14

        if toast {
          Row {
            padding: [14, 12]
            background: alpha(green, 0.15)
            border: 1
            borderColor: alpha(green, 0.5)
            radius: 10 * corners
            Text { text: "✓"; color: green; bold: true }
            Text { text: "Well done, one craving down. It's logged."; color: green; weight: 1 }
          }
        }

        Column {
          gap: 4
          Text { text: "ONE DAY AT A TIME"; style: label; color: accent; letterSpacing: 2 }
          if trim(motivation) != "" {
            Text { text: "“${trim(motivation)}”"; italic: true; color: foreground; fontSize: 15 }
          } else {
            Text { spans: ["Write why you're quitting in ", {text: "Help", color: accent, bold: true}, " and it will show here."]; style: small; color: muted }
          }
        }

        Row {
          gap: 8
          Stat { label: "saved"; value: economise > 0 ? "${cur}${fmtNum(economise)}" : "${cur} —"; tint: green }
          Stat { label: "resisted"; value: "${len(envies)}" }
          Stat { label: "best streak"; value: "${floor(meilleur / 86400)} d"; tint: accent }
        }

        if len(items) == 0 {
          Column {
            gap: 6
            padding: [16, 28]
            align: center
            background: surface
            radius: 12 * corners
            Text { text: "Nothing tracked yet"; fontSize: 18; fontWeight: 600; font: display; align: center }
            Text { text: "Add what you're quitting, even if you stopped long ago: the start date is all it takes."; style: small; color: muted; align: center }
          }
        } else {
          Box {
            fill: width
            padding: [16, 18]
            radius: 14 * corners
            background: linear(0, 0, 1, 1, [accent, mix(accent, magenta, 0.55)])
            onTap: { vue = "envie"; retour = "accueil"; respDebut = sec ?? now; eId = items.any(a => a.id == eId) ? eId : items[0].id; eForce = 3; eDecl = "" }
            Column {
              gap: 2
              Text { text: "I have a craving"; fontSize: 20; fontWeight: 700; font: display; color: background }
              Text { text: "Breathe with me for two minutes, it will pass."; style: small; color: alpha(background, 0.8) }
            }
          }
        }

        if len(items) > 0 { Section { label: "WHAT I'M QUITTING" } }
        for a in suivis key a.id {
          Row {
            gap: 14
            align: center
            padding: [14, 14]
            background: linear(0, 0, 1, 0, [alpha(a.tint, 0.13), surface])
            border: 1
            borderColor: alpha(a.tint, 0.35)
            radius: 14 * corners
            onTap: { let v = a.type == "reseaux" || a.type == "porno" ? a.minJour ?? 0 : a.parSemaine ?? 0; sel = a.id; vue = "fiche"; retour = "accueil"; confirmer = ""; prix = v > 0 ? "${v}" : ""; nomFiche = a.nom }
            Box {
              size: 66
              align: center
              Ring { fill: true; thickness: 5; value: a.part; color: a.tint; track: alpha(a.tint, 0.15) }
              Image { src: logos[a.type] ?? ic_autre; size: 28; tint: a.tint; label: a.nom }
            }
            Column {
              weight: 1
              gap: 1
              Text { text: upper(a.nom); style: label; color: a.tint; letterSpacing: 1.5; maxLines: 1 }
              if a.el >= 86400 {
                Text { spans: [{text: fmtNum(floor(a.el / 86400)), fontSize: 30, fontWeight: 700}, {text: a.el >= 172800 ? " days" : " day", color: muted, fontSize: 14}]; font: display; maxLines: 1 }
              } else {
                Text { spans: [{text: "${floor(a.el / 3600)}", fontSize: 30, fontWeight: 700}, {text: " h ", color: muted, fontSize: 14}, {text: "${floor(a.el % 3600 / 60)}", fontSize: 30, fontWeight: 700}, {text: " min", color: muted, fontSize: 14}]; font: display; maxLines: 1 }
              }
              if a.suiv != null {
                Row {
                  gap: 4
                  Text { text: "Next: ${a.suiv.l}, in"; style: small; color: muted; maxLines: 1 }
                  Duree { s: a.suiv.t - a.el }
                }
              } else {
                Text { text: "Every milestone reached"; style: small; color: green }
              }
            }
            Text { text: "›"; color: muted; fontSize: 22 }
          }
        }

        BoutonAjout { depuis: "accueil" }
        Spacer { height: 8 }
      }

    } else if vue == "fiche" && item != null {
      Column {
        weight: 1
        scroll: true
        padding: [16, 8]
        gap: 14

        Column {
          align: center
          gap: 6
          Box {
            size: 230
            align: center
            Ring { fill: true; thickness: 3; value: 1; color: alpha(item.tint, 0.12); track: transparent }
            Ring { fill: true; thickness: 12; value: item.part; color: item.tint; track: alpha(item.tint, 0.12); scale: 0.9; animate value: spring() }
            Column {
              gap: 0
              align: center
              Image { src: logos[item.type] ?? ic_autre; size: 30; tint: item.tint; label: item.nom }
              Text { text: iJours >= 1 ? fmtNum(iJours) : "${floor(item.el / 3600)} h"; fontSize: 68; fontWeight: 700; font: display; align: center; color: foreground }
              Text { text: iJours >= 1 ? (iJours > 1 ? "DAYS FREE" : "DAY FREE") : "FREE"; style: label; color: item.tint; letterSpacing: 2; align: center }
            }
          }
          Text { text: "${pad(floor(iSec % 86400 / 3600), 2, "0")} h  ${pad(floor(iSec % 3600 / 60), 2, "0")} min  ${pad(iSec % 60, 2, "0")} s"; font: mono; color: muted; align: center }
          Text { text: "since ${fmtTime(item.debut, 'EEEE, MMMM d, yyyy', null, 'en')} at ${fmtTime(item.debut, 'HH:mm')}"; style: small; color: muted; align: center }
        }

        Row {
          gap: 8
          Stat { label: "record"; value: "${floor(item.best / 86400)} d"; tint: item.tint }
          if iTemps {
            Stat { label: "time won back"; value: iHeures <= 0 ? "— h" : iHeures >= 48 ? "${fmtNum(iHeures / 24)} d" : "${fmtNum(iHeures)} h"; tint: green }
          } else {
            Stat { label: "saved"; value: (item.parSemaine ?? 0) > 0 ? "${cur}${fmtNum(item.el / 604800 * item.parSemaine)}" : "${cur} —"; tint: green }
          }
        }
        Row {
          gap: 8
          Stat { label: "cravings resisted"; value: "${iEnvies}" }
          Stat { label: "relapses"; value: "${len(item.rechutes ?? [])}" }
        }

        if item.suiv != null {
          Column {
            gap: 6
            padding: [14, 12]
            background: alpha(item.tint, 0.10)
            border: 1
            borderColor: alpha(item.tint, 0.4)
            radius: 12 * corners
            Row {
              Text { text: "NEXT MILESTONE"; style: label; color: item.tint; letterSpacing: 1.5; weight: 1 }
              Duree { s: item.suiv.t - item.el; tint: item.tint }
            }
            Text { text: item.suiv.l; fontSize: 18; fontWeight: 600; font: display }
            Text { text: item.suiv.d; style: small; color: muted }
            Progress { value: item.part * 100; color: item.tint; track: alpha(item.tint, 0.15) }
          }
        }

        Section { label: iTemps ? "WHAT CHANGES FOR YOU" : "WHAT'S HAPPENING IN YOUR BODY" }
        Column {
          gap: 0
          for e, i in item.ets key e.t {
            Row {
              gap: 12
              align: top
              Column {
                width: 22
                gap: 0
                align: center
                Box {
                  size: 22
                  radius: 11
                  align: center
                  background: e.t <= item.el ? item.tint : transparent
                  border: e.t <= item.el ? 0 : 1.5
                  borderColor: alpha(muted, 0.6)
                  Text { text: e.t <= item.el ? "✓" : ""; fontSize: 12; bold: true; color: background; align: center }
                }
                if i < len(item.ets) - 1 {
                  Box { width: 2; height: 46; background: e.t <= item.el ? alpha(item.tint, 0.6) : alpha(muted, 0.25) }
                }
              }
              Column {
                weight: 1
                gap: 1
                padding: [0, 1, 0, 10]
                Row {
                  Text { text: e.l; bold: true; color: e.t <= item.el ? foreground : muted; weight: 1 }
                  if e.t > item.el { Duree { s: e.t - item.el } }
                }
                Text { text: e.d; style: small; color: muted }
              }
            }
          }
        }
        if item.type == "vape" {
          Text { text: "Vaping involves no combustion: these milestones mostly follow nicotine and habit. Its effects on the lungs are less studied than smoking's."; style: small; color: muted }
        }

        Section { label: "BADGES" }
        Grid {
          columns: 4
          gap: 10
          for p in paliers key p.t {
            Column {
              gap: 3
              align: center
              Box {
                size: 58
                radius: 29
                align: center
                background: p.t <= item.best ? alpha(item.tint, p.t <= item.el ? 0.9 : 0.35) : transparent
                border: p.t <= item.best ? 0 : 1.5
                borderColor: iPalier != null && p.t == iPalier.t ? item.tint : alpha(muted, 0.35)
                Text { text: p.c; fontSize: len(p.c) > 2 ? 15 : 19; fontWeight: 700; font: display; align: center; color: p.t <= item.best ? background : muted }
              }
              Text { text: p.u; style: small; color: p.t <= item.el ? foreground : muted; align: center }
            }
          }
        }
        if iPalier != null {
          Row {
            gap: 4
            justify: center
            Text { text: "Next badge in"; style: small; color: muted }
            Duree { s: iPalier.t - item.el; tint: item.tint }
          }
        }

        Section { label: iTemps ? "TIME" : "MONEY" }
        Column {
          gap: 4
          padding: [14, 10]
          background: surface
          radius: 12 * corners
          Text { text: iTemps ? "Time you spent on it per day (minutes)" : "What you spent on it per week (${cur})"; style: small; color: muted }
          Input {
            text: prix
            placeholder: iTemps ? "E.g. 60" : "E.g. 15"
            onChange: {
              prix = value
              let v = num(replace(value, ",", "."), 0)
              items = items.map(x => x.id == sel ? merge(x, iTemps ? {minJour: v} : {parSemaine: v}) : x)
            }
          }
          if iTemps && (item.minJour ?? 0) > 0 {
            Text { text: "That's ${fmtNum(item.minJour * 30 / 60)} h a month, and ${fmtNum(iHeures)} h won back already."; style: small; color: green }
          } else if !iTemps && (item.parSemaine ?? 0) > 0 {
            Text { text: "That's ${cur}${fmtNum(item.parSemaine * 52)} a year, and ${cur}${fmtNum(item.el / 604800 * item.parSemaine, 2)} saved already."; style: small; color: green }
          }
        }

        if item.type == "porno" {
          Text { text: "This name also shows on the home-screen widget: you can change it below to something discreet."; style: small; color: muted }
        }
        if item.type == "alcool" {
          Text { text: "If you drank heavily every day, stopping suddenly can be dangerous: alcohol withdrawal should be done with a doctor."; style: small; color: muted }
        }

        Section { label: "DISPLAY NAME" }
        Column {
          gap: 4
          padding: [14, 10]
          background: surface
          radius: 12 * corners
          Input {
            text: nomFiche
            placeholder: "Name of this quit"
            onChange: {
              nomFiche = value
              if trim(value) != "" { items = items.map(x => x.id == sel ? merge(x, {nom: trim(value)}) : x) }
            }
          }
          Text { text: "In the app and on the home-screen widget."; style: small; color: muted }
        }

        Spacer { height: 4 }
        Column {
          gap: 8
          Box {
            fill: width
            padding: [14, 12]
            radius: 12 * corners
            border: 1
            borderColor: confirmer == "rechute" ? red : alpha(muted, 0.4)
            background: confirmer == "rechute" ? alpha(red, 0.12) : transparent
            onTap: {
              if confirmer == "rechute" {
                items = items.map(x => x.id == sel ? merge(x, {debut: now, record: max(x.record ?? 0, now - x.debut), rechutes: (x.rechutes ?? []) + [now]}) : x)
                confirmer = ""
              } else {
                confirmer = "rechute"
              }
            }
            Column {
              gap: 2
              Text { text: confirmer == "rechute" ? "Tap again to restart from now" : "I relapsed"; bold: true; color: confirmer == "rechute" ? red : foreground; align: center }
              Text { text: "Your record and history are kept. A relapse is part of the journey."; style: small; color: muted; align: center }
            }
          }
          Row {
            justify: center
            onTap: {
              if confirmer == "suppr" {
                items = items.filter(x => x.id != sel)
                envies = envies.filter(e => e.id != sel)
                confirmer = ""
                vue = "accueil"
              } else {
                confirmer = "suppr"
              }
            }
            Text { text: confirmer == "suppr" ? "Tap again to delete “${item.nom}”" : "Delete this quit"; style: small; color: confirmer == "suppr" ? red : muted }
          }
        }
        Spacer { height: 12 + screenInset }
      }

    } else if vue == "envie" {
      Column {
        weight: 1
        scroll: true
        padding: [16, 8]
        gap: 16

        Box {
          fill: width
          height: 260
          align: center
          Canvas {
            size: 250
            circle(width / 2, height / 2, min(width, height) / 2 - 3, stroke: alpha(eTint, 0.3), width: 1.5)
          }
          Canvas {
            size: 250
            scale: rGrow
            animate scale: tween(1s, "linear")
            let cx = width / 2
            let cy = height / 2
            let r = min(width, height) / 2 - 8
            circle(cx, cy, r + 6, fill: alpha(eTint, 0.10))
            circle(cx, cy, r, fill: radial(cx, cy, r, [alpha(eTint, 0.55), alpha(eTint, 0.18)]))
            circle(cx, cy, r, stroke: eTint, width: 2)
          }
          Column {
            gap: 0
            align: center
            Text { text: rPhase < 4 ? "Breathe in" : "Breathe out"; fontSize: 26; fontWeight: 600; font: display; align: center }
            Text { text: "${rPhase < 4 ? 4 - rPhase : 10 - rPhase}"; fontSize: 18; color: alpha(foreground, 0.7); align: center; font: display }
          }
        }
        Text {
          text: rt >= 120 ? "Two minutes done. The craving has already eased." : "Breath ${floor(rt / 10) + 1} of 12 · ${floor((120 - rt) / 60)} min ${pad((120 - rt) % 60, 2, "0")} s"
          style: small; color: rt >= 120 ? green : muted; align: center
        }
        Text {
          text: conseils[floor(rt / 15) % len(conseils)]
          align: center; padding: [14, 12]; background: surface; radius: 12 * corners
        }

        Section { label: "A CRAVING FOR WHAT?" }
        Flow {
          gap: 8
          for a in items key a.id { Box { onTap: eId = a.id; Chip { label: a.nom; on: eId == a.id; tint: teinte[a.type] ?? green } } }
        }
        Section { label: "INTENSITY" }
        Row {
          gap: 6
          for f, i in forces {
            Column {
              weight: 1
              gap: 3
              align: center
              padding: [0, 8]
              radius: 10 * corners
              background: eForce == i + 1 ? alpha(eTint, 0.9) : alpha(eTint, 0.08)
              onTap: eForce = i + 1
              Text { text: "${i + 1}"; fontSize: 18; fontWeight: 700; font: display; align: center; color: eForce == i + 1 ? background : foreground }
              Text { text: f; fontSize: 9; align: center; maxLines: 1; color: eForce == i + 1 ? background : muted }
            }
          }
        }
        Section { label: "WHAT TRIGGERED IT?" }
        Flow {
          gap: 8
          for d in declencheurs { Box { onTap: eDecl = eDecl == d ? "" : d; Chip { label: d; on: eDecl == d } } }
        }

        Box {
          fill: width
          padding: [16, 16]
          radius: 14 * corners
          background: linear(0, 0, 1, 1, [green, mix(green, cyan, 0.5)])
          onTap: {
            let nouv = envies + [{t: sec ?? now, id: eId, f: eForce, d: eDecl}]
            envies = len(nouv) > 800 ? nouv.drop(len(nouv) - 800) : nouv
            merci = sec ?? now
            toast = true
            respDebut = 0
            vue = "accueil"
            haptic()
          }
          Text { text: "It passed, I'm holding on"; fontSize: 17; fontWeight: 700; font: display; color: background; align: center }
        }
        Spacer { height: 12 + screenInset }
      }

    } else if vue == "journal" {
      Column {
        weight: 1
        scroll: true
        padding: [16, 8]
        gap: 14

        Row {
          gap: 8
          Stat { label: "today"; value: "${enviesJour}"; tint: accent }
          Stat { label: "7 days"; value: "${envies7}" }
          Stat { label: "avg. intensity"; value: len(envies) > 0 ? "${fixed(forceMoy, 1)}" : "—" }
        }

        if len(envies) == 0 {
          Column {
            gap: 6
            padding: [16, 28]
            align: center
            background: surface
            radius: 12 * corners
            Text { text: "Nothing yet"; fontSize: 18; fontWeight: 600; font: display; align: center }
            Text { text: "Every craving you resist and log with “I have a craving” will show here, with its time and trigger."; style: small; color: muted; align: center }
          }
        } else {
          Section { label: "CRAVINGS RESISTED · 14 DAYS" }
          Column {
            padding: [12, 12]
            background: surface
            radius: 12 * corners
            Canvas {
              height: 130
              fill: width
              let bw = width / 14
              for v, i in jours14 {
                let h = v / max14 * (height - 30)
                rect(i * bw + 3, height - 18 - max(h, 2), bw - 6, max(h, 2), radius: 3 * corners, fill: i == 13 ? accent : alpha(accent, 0.45))
                if v > 0 { text("${v}", i * bw + bw / 2, height - 26 - h, size: 10, align: center, color: muted) }
                text(fmtTime(debutJour - (13 - i) * 86400, "EEEEE", null, "en"), i * bw + bw / 2, height - 7, size: 9, align: center, color: i == 13 ? foreground : muted)
              }
            }
          }

          Section { label: "WHAT TIME" }
          Column {
            gap: 6
            padding: [12, 12]
            background: surface
            radius: 12 * corners
            Canvas {
              height: 90
              fill: width
              let bw = width / 24
              for v, h in heures {
                let bh = v / maxH * (height - 22)
                rect(h * bw + 1.5, height - 16 - max(bh, 2), bw - 3, max(bh, 2), radius: 2 * corners, fill: h == heurePic ? orange : alpha(orange, 0.4))
              }
              for h in [0, 6, 12, 18] { text("${h} h", h * width / 24 + 2, height - 6, size: 9, color: muted) }
            }
            Text { spans: ["The hardest time: ", {text: "around ${heurePic}:00", bold: true, color: orange}, ". Plan something to do at that hour."]; style: small; color: muted }
          }

          if len(declStats) > 0 {
            Section { label: "TRIGGERS" }
            Column {
              gap: 10
              padding: [14, 12]
              background: surface
              radius: 12 * corners
              for x in declStats.take(6) key x.d {
                Column {
                  gap: 4
                  Row {
                    Text { text: x.d; weight: 1 }
                    Text { text: "${x.n}"; color: muted; font: display; bold: true }
                  }
                  Progress { value: x.n / declStats[0].n * 100; color: magenta; track: alpha(magenta, 0.12) }
                }
              }
            }
          }

          Section { label: "RECENT CRAVINGS" }
          Column {
            gap: 0
            for e in derniers key e.t {
              Column {
                let a = items.find(x => x.id == e.id)
                let tint = teinte[get(a ?? {}, "type", "autre")] ?? muted
                Row {
                  gap: 10
                  align: center
                  padding: [2, 10]
                  Image { src: logos[get(a ?? {}, "type", "autre")] ?? ic_autre; size: 20; tint: tint }
                  Column {
                    weight: 1
                    gap: 0
                    Text { text: "${get(a ?? {}, "nom", "Deleted")}${e.d != "" ? " · ${e.d}" : ""}"; maxLines: 1 }
                    Text { text: fmtTime(e.t, "EEE, MMM d · HH:mm", null, "en"); style: small; color: muted }
                  }
                  Row {
                    gap: 2
                    for k in range(5) { Box { width: 4; height: 6 + k * 3; radius: 1; background: k < e.f ? tint : alpha(muted, 0.25) } }
                  }
                }
                Box { height: 1; fill: width; background: alpha(border, 0.5) }
              }
            }
          }
        }
        Spacer { height: 8 }
      }

    } else if vue == "aide" {
      Column {
        weight: 1
        scroll: true
        padding: [16, 8]
        gap: 14

        Section { label: "WHY I'M QUITTING" }
        Column {
          gap: 4
          padding: [14, 10]
          background: surface
          radius: 12 * corners
          Input { text: motivation; placeholder: "For my health, my family, my wallet…"; onChange: motivation = value }
          Text { text: "This line shows at the top of the home view."; style: small; color: muted }
        }

        Section { label: "WHEN A CRAVING HITS" }
        Column {
          gap: 10
          padding: [14, 12]
          background: surface
          radius: 12 * corners
          for c, i in [
            {t: "Wait", d: "It peaks, then fades within a few minutes."},
            {t: "Breathe", d: "Breathe in for 4 seconds, out for 6. The “I have a craving” button guides you."},
            {t: "Drink water", d: "Slowly, in small sips."},
            {t: "Move", d: "Change rooms, walk, take the stairs."},
            {t: "Talk about it", d: "A message to someone close is often enough."}
          ] {
            Row {
              gap: 12
              align: top
              Box {
                size: 26
                radius: 13
                align: center
                background: accent
                Text { text: "${i + 1}"; align: center; bold: true; color: background; font: display }
              }
              Column {
                weight: 1
                gap: 1
                Text { text: c.t; bold: true }
                Text { text: c.d; style: small; color: muted }
              }
            }
          }
        }
        Text { text: "A doctor or pharmacist can help too, including with nicotine replacement."; style: small; color: muted }

        Section { label: "CURRENCY" }
        Column {
          gap: 4
          padding: [14, 10]
          background: surface
          radius: 12 * corners
          Input { text: currency; placeholder: "$"; onChange: currency = value }
          Text { text: "Used for money saved, in the app and on the widget: $, €, £, ¥…"; style: small; color: muted }
        }

        Section { label: "MY QUITS" }
        BoutonAjout { depuis: "aide" }
        Spacer { height: 8 }
      }

    } else if vue == "ajout" {
      Column {
        weight: 1
        scroll: true
        padding: [16, 8]
        gap: 12
        Section { label: "WHAT?" }
        Input { text: nNom; placeholder: "E.g. Sugar, gambling, cannabis…"; onChange: nNom = value; focus: true }
        Section { label: "TYPE" }
        Flow {
          gap: 8
          for t in types { Box { onTap: { nType = t.k; nNom = trim(nNom) == "" && t.k != "autre" && t.k != "porno" ? t.l : nNom }; Chip { label: t.l; on: nType == t.k; tint: teinte[t.k] } } }
        }
        Text { text: nType == "autre" ? "General milestones, without health details." : nType == "porno" ? "The name shows on the home-screen widget: pick a discreet one if you prefer (“Late-night screens”, “P”…)." : "With milestones specific to this type."; style: small; color: muted }
        Section { label: "SINCE WHEN?" }
        Input { text: nDate; placeholder: "YYYY-MM-DD HH:MM, empty for now"; onChange: nDate = value }
        if trim(nDate) != "" {
          Text {
            text: nDebut == null ? "Date not recognized: write for example 2026-10-20 16:00." : nDebut > now + 60 ? "This date is in the future." : "Since ${fmtTime(nDebut, 'EEEE, MMMM d, yyyy', null, 'en')} at ${fmtTime(nDebut, 'HH:mm')}"
            style: small; color: nDebut != null && nDebut <= now + 60 ? green : red
          }
        }
        Spacer { height: 6 }
        Box {
          fill: width
          padding: [16, 14]
          radius: 14 * corners
          background: nOk ? accent : alpha(muted, 0.2)
          onTap: {
            if nOk {
              let id = "${nType}-${now}"
              items = items + [{id: id, nom: trim(nNom), type: nType, debut: nDebut, parSemaine: 0, minJour: 0, record: 0, rechutes: []}]
              sel = id
              prix = ""
              nomFiche = trim(nNom)
              confirmer = ""
              vue = "fiche"
              retour = "accueil"
            }
          }
          Text { text: "Start tracking"; bold: true; align: center; color: nOk ? background : muted }
        }
        Spacer { height: 12 + screenInset }
      }
    }

    // tab bar
    if vue == "accueil" || vue == "journal" || vue == "aide" {
      Box { height: 1; fill: width; background: alpha(border, 0.6) }
      Row {
        padding: [8, 8, 8, 8 + screenInset]
        background: surface
        for t in [{k: "accueil", l: "Home"}, {k: "journal", l: "Journal"}, {k: "aide", l: "Help"}] {
          Column {
            weight: 1
            gap: 3
            align: center
            onTap: vue = t.k
            Icone { k: t.k; tint: vue == t.k ? accent : muted }
            Text { text: t.l; style: small; align: center; bold: vue == t.k; color: vue == t.k ? accent : muted }
          }
        }
      }
    }
  }
}
